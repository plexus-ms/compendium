amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    stash = true
    steps {
      ["check"] {
        glob = List("essentials/standard.md", "contracts/*.md", "approaches/*.md", "essentials/requirements.sh")
        check = "mise check"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["verify"] {
        check = "mise verify"
      }
    }
  }
}
