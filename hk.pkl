amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    stash = true
    steps {
      ["check"] {
        glob = List("plexus/standard.md", "modules/*.md", "plexus/requirements.sh")
        check = "mise check"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["check"] {
        check = "mise check"
      }
    }
  }
}
